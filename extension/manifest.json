{
  "manifest_version": 3,
  "name": "Movie Manager",
  "version": "0.3.9",
  "description": "Search and sync local movie indexes from a manually installed browser extension.",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "app.html",
    "default_title": "Movie Manager"
  }
}
