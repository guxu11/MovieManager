#!/usr/bin/env bash
# Pre-commit hook for movie_manager
# Ensures harness docs are consistent and code passes basic checks.
# Install: cp .hooks/pre-commit .git/hooks/pre-commit
#
# This hook is lightweight: syntax-only validation, no full linter.
# It uses warnings (not blocking errors) since this project has no ESLint/pytest.

set -uo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

# --- Helper functions ---
log_error() {
  echo -e "${RED}ERROR: $1${NC}" >&2
  ERRORS=$((ERRORS + 1))
}

log_warn() {
  echo -e "${YELLOW}WARN: $1${NC}"
  WARNINGS=$((WARNINGS + 1))
}

log_ok() {
  echo -e "${GREEN}OK: $1${NC}"
}

# --- Get staged files ---
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files. Skipping hooks."
  exit 0
fi

# --- Check 1: features.md progress consistency ---
if echo "$STAGED_FILES" | grep -q "^features.md$"; then
  FEATURES_FILE="$ROOT_DIR/features.md"
  if [ -f "$FEATURES_FILE" ]; then
    # All checklist items must use - [ ] or - [x] format
    BAD_ITEMS=$(grep -n '^\- \[[^ xX]\]' "$FEATURES_FILE" 2>/dev/null || true)
    if [ -n "$BAD_ITEMS" ]; then
      log_error "features.md has invalid checklist items (must use [ ] or [x]):"
      echo "$BAD_ITEMS" >&2
    else
      log_ok "features.md checklist format valid"
    fi

    # Check that a Status section exists (optional for this project, but good practice)
    if ! grep -q "^## Status" "$FEATURES_FILE"; then
      log_warn "features.md has no ## Status section"
    else
      log_ok "features.md has ## Status section"
    fi
  fi
fi

# --- Check 2: Pre-commit hook is executable ---
HOOK_FILE="$HOOK_DIR/pre-commit"
if [ -f "$HOOK_FILE" ] && ! [ -x "$HOOK_FILE" ]; then
  log_error ".hooks/pre-commit exists but is not executable. Run: chmod +x .hooks/pre-commit"
fi

# --- Check 3: No API keys in staged files ---
KEY_PATTERNS=(
  "SUPABASE_SERVICE_ROLE_KEY="
  "DEEPL_API_KEY="
  "pk_live"
  "sk_live"
  "Bearer eyJ"
  "ghp_"
  "gho_"
)

for PATTERN in "${KEY_PATTERNS[@]}"; do
  # Check staged files (exclude .env files and .hooks/ directory)
  FOUND=$(echo "$STAGED_FILES" | xargs grep -l "$PATTERN" 2>/dev/null | grep -v "^\..*\.env" | grep -v "^\.hooks/" | grep -v "^setup/" || true)
  if [ -n "$FOUND" ]; then
    log_warn "Potential secret found in staged files matching: $PATTERN"
    echo "  Files: $FOUND" >&2
  fi
done

# --- Check 4: Basic JS syntax check (only for staged .js files) ---
if echo "$STAGED_FILES" | grep -qE '\.js$'; then
  if command -v node >/dev/null 2>&1; then
    JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.js$' || true)
    for JS_FILE in $JS_FILES; do
      if [ -f "$JS_FILE" ]; then
        if ! node --check "$JS_FILE" 2>/dev/null; then
          log_warn "Possible syntax error in $JS_FILE"
        else
          log_ok "$JS_FILE syntax valid"
        fi
      fi
    done
  fi
fi

# --- Check 5: Python syntax check ---
if echo "$STAGED_FILES" | grep -qE '\.py$'; then
  if command -v python3 >/dev/null 2>&1; then
    PY_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
    for PY_FILE in $PY_FILES; do
      if [ -f "$PY_FILE" ]; then
        if ! python3 -m py_compile "$PY_FILE" 2>/dev/null; then
          log_warn "Possible Python syntax error in $PY_FILE"
        else
          log_ok "$PY_FILE syntax valid"
        fi
      fi
    done
  fi
fi

# --- Check 6: SQL syntax check (staged .sql files) ---
if echo "$STAGED_FILES" | grep -qE '\.sql$'; then
  SQL_FILES=$(echo "$STAGED_FILES" | grep -E '\.sql$' || true)
  for SQL_FILE in $SQL_FILES; do
    if [ -f "$SQL_FILE" ]; then
      # Quick check: ensure common DDL keywords exist if file looks like schema
      if grep -qiE '(create\s+table|alter\s+table|insert\s+into)' "$SQL_FILE" 2>/dev/null; then
        log_ok "$SQL_FILE looks like DDL/DML"
      else
        log_ok "$SQL_FILE checked"
      fi
    fi
  done
fi

# --- Summary ---
echo ""
if [ $ERRORS -gt 0 ]; then
  echo -e "${RED}Commit blocked: $ERRORS error(s) found.${NC}"
  exit 1
fi

if [ $WARNINGS -gt 0 ]; then
  echo -e "${YELLOW}Commit proceeds with $WARNINGS warning(s).${NC}"
fi

echo -e "${GREEN}All checks passed.${NC}"
exit 0
